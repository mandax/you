#!/bin/sh
# Release environment configuration
#
# This script runs before the VM starts. Variables exported here
# are available to the Elixir application at runtime.

# Enable Erlang distribution (required for consumer apps to connect)
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"

# Erlang node name — consumer apps use this to call You.IAM.Server
export RELEASE_NODE="${RELEASE_NODE:-you@${HOSTNAME:-you.example.com}}"

# Erlang cookie — no predictable default. When unset, a random per-boot
# value is used so an unconfigured node refuses consumer connections
# (fail closed). Set RELEASE_COOKIE or the `erlang_cookie` setting for
# anything to connect. The settings-table value is applied after boot via
# Node.set_cookie/1 and overrides whatever is set here.
if [ -z "$RELEASE_COOKIE" ]; then
  RELEASE_COOKIE="bootstrap_$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')"
fi
export RELEASE_COOKIE
