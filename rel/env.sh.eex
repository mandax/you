#!/bin/sh
# Release environment configuration
#
# This script runs before the VM starts. Variables exported here
# are available to the Elixir application at runtime.
#
# See: https://hexdocs.pm/mix/Mix.Tasks.Release.html

# Enable Erlang distribution (required for consumer apps to connect)
# Valid values: name (long names), sname (short names), none (default)
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"

# Erlang node name — consumer apps use this to call You.IAM.Server
# Format: you@hostname  (must be resolvable by consumer app containers)
export RELEASE_NODE="${RELEASE_NODE:-you@${HOSTNAME:-you.internal}}"

# Erlang cookie — MUST match on all connected nodes (You + consumer apps)
# Generate one with: openssl rand -base64 32
export RELEASE_COOKIE="${RELEASE_COOKIE:-}"
