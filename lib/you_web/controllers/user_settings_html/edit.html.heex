<Layouts.app flash={@flash} current_scope={@current_scope} active_tab="settings">
  <:side_panel>
    <Layouts.account_nav active="settings" />
  </:side_panel>

  <div class="space-y-10">
    <%!-- Single mode has no app grid to launch from, so the way back into the
          app lives here — this page is the account area. --%>
    <section
      :if={@single_app}
      id="single-app"
      class="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-border bg-muted/30 px-4 py-3"
    >
      <div class="min-w-0">
        <div class="text-sm font-medium truncate">{@single_app.name}</div>
        <div class="text-xs text-muted-foreground">You are signed in to this application.</div>
      </div>
      <.button size="sm" href={You.Admin.App.launch_target(@single_app)} id="open-single-app">
        Open {@single_app.name}
      </.button>
    </section>

    <section id="general">
      <h2 class="text-lg font-medium tracking-tight mb-6">Email</h2>
      <.form :let={f} for={@email_changeset} action={~p"/users/settings"} id="update_email">
        <input type="hidden" name="action" value="update_email" />
        <div class="space-y-4 max-w-sm">
          <.input
            field={f[:email]}
            type="email"
            label="Email"
            autocomplete="username"
            spellcheck="false"
            required
          />
          <.button type="submit" variant="default" phx-disable-with="Changing...">
            Change Email
          </.button>
        </div>
      </.form>
    </section>

    <div class="border-t border-border" />

    <section id="password">
      <h2 class="text-lg font-medium tracking-tight mb-6">Password</h2>
      <.form :let={f} for={@password_changeset} action={~p"/users/settings"} id="update_password">
        <input type="hidden" name="action" value="update_password" />
        <div class="space-y-4 max-w-sm">
          <.input
            field={f[:password]}
            type="password"
            label="New password"
            autocomplete="new-password"
            spellcheck="false"
            required
          />
          <.input
            field={f[:password_confirmation]}
            type="password"
            label="Confirm new password"
            autocomplete="new-password"
            spellcheck="false"
            required
          />
          <.button type="submit" variant="default" phx-disable-with="Changing...">
            Save Password
          </.button>
        </div>
      </.form>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-medium">Active sessions</h2>
          <p class="text-sm text-muted-foreground">
            Devices currently signed in to your account.
          </p>
        </div>
        <.link
          :if={length(@sessions) > 1}
          href={~p"/users/settings/sessions"}
          method="delete"
          data-confirm="Sign out of all other sessions?"
          class="text-sm text-destructive hover:underline"
        >
          Sign out everywhere else
        </.link>
      </div>

      <ul class="max-h-72 divide-y divide-border overflow-y-auto rounded-lg border border-border">
        <li :for={s <- @sessions} class="flex items-center justify-between px-4 py-3">
          <div class="text-sm">
            <div class="flex items-center gap-2">
              <span class="lucide-monitor size-4 block text-muted-foreground" />
              <span>Session</span>
              <span
                :if={s.token == @current_token}
                class="rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary"
              >
                This device
              </span>
            </div>
            <div class="mt-1 font-mono text-xs text-muted-foreground">
              signed in {Calendar.strftime(
                s.authenticated_at || s.inserted_at,
                "%Y-%m-%d %H:%M UTC"
              )}
            </div>
          </div>
          <.link
            :if={s.token != @current_token}
            href={~p"/users/settings/sessions/#{s.id}"}
            method="delete"
            data-confirm="Revoke this session?"
            class="text-sm text-muted-foreground hover:text-destructive"
          >
            Revoke
          </.link>
        </li>
      </ul>
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-lg font-medium">Connected accounts</h2>
        <p class="text-sm text-muted-foreground">
          External identity providers linked to your account.
        </p>
      </div>

      <p :if={@federated_identities == []} class="text-sm text-muted-foreground">
        No connected accounts.
      </p>

      <ul
        :if={@federated_identities != []}
        class="divide-y divide-border rounded-lg border border-border"
      >
        <li
          :for={identity <- @federated_identities}
          class="flex items-center justify-between px-4 py-3"
        >
          <div class="text-sm">
            <div class="flex items-center gap-2">
              <span class="lucide-link size-4 block text-muted-foreground" />
              <span class="font-medium">{String.capitalize(identity.provider)}</span>
            </div>
            <div class="mt-1 font-mono text-xs text-muted-foreground">{identity.email}</div>
          </div>
          <.link
            href={~p"/users/settings/federated/#{identity.id}"}
            method="delete"
            data-confirm="Unlink this account?"
            class="text-sm text-muted-foreground hover:text-destructive"
          >
            Unlink
          </.link>
        </li>
      </ul>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-medium">Two-factor authentication</h2>
          <p class="text-sm text-muted-foreground">
            <%= if @current_scope.user.totp_enabled do %>
              Authenticator app is enabled. {@recovery_codes_remaining} recovery code(s) remaining.
            <% else %>
              Add an extra layer of security by requiring a code from your authenticator app.
            <% end %>
          </p>
          <p
            :if={@current_scope.user.totp_enabled and @recovery_codes_remaining <= 2}
            class="mt-2 flex items-center gap-2 text-sm text-destructive"
          >
            <.icon name="danger-circle" class="size-4 shrink-0" />
            <%= if @recovery_codes_remaining == 0 do %>
              You have no recovery codes left. Regenerate them now or you may be
              locked out if you lose your authenticator app.
            <% else %>
              Running low on recovery codes. Regenerate them before you run out.
            <% end %>
          </p>
        </div>
        <div class="flex shrink-0 items-center gap-4">
          <%= if @current_scope.user.totp_enabled do %>
            <.link
              href={~p"/users/settings/totp/recovery-codes"}
              method="post"
              data-confirm="Regenerate recovery codes? Your existing codes will stop working immediately."
              class="text-sm text-foreground hover:underline whitespace-nowrap"
            >
              Regenerate codes
            </.link>
            <.link
              href={~p"/users/settings/totp"}
              method="delete"
              data-confirm="Disable two-factor authentication?"
              class="text-sm text-destructive hover:underline whitespace-nowrap"
            >
              Disable
            </.link>
          <% else %>
            <.link
              navigate={~p"/users/settings/totp"}
              class="text-sm text-foreground hover:underline whitespace-nowrap"
            >
              Set up authenticator app →
            </.link>
          <% end %>
        </div>
      </div>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-medium">Email verification codes</h2>
          <p class="text-sm text-muted-foreground">
            <%= if @current_scope.user.email_2fa_enabled do %>
              A one-time code is emailed to you at each password sign-in.
            <% else %>
              Require a one-time code sent to your email at each password sign-in.
            <% end %>
          </p>
        </div>
        <%= if @current_scope.user.email_2fa_enabled do %>
          <.link
            href={~p"/users/settings/email-2fa"}
            method="delete"
            data-confirm="Turn off email verification codes?"
            class="text-sm text-destructive hover:underline whitespace-nowrap"
          >
            Disable
          </.link>
        <% else %>
          <.link
            href={~p"/users/settings/email-2fa"}
            method="post"
            class="text-sm text-foreground hover:underline whitespace-nowrap"
          >
            Enable →
          </.link>
        <% end %>
      </div>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-medium">Passkeys</h2>
          <p class="text-sm text-muted-foreground">
            Sign in without a password using a fingerprint, face unlock, or security key.
          </p>
        </div>
        <.link
          navigate={~p"/users/settings/passkeys"}
          class="text-sm text-foreground hover:underline whitespace-nowrap"
        >
          Manage passkeys →
        </.link>
      </div>
    </section>
  </div>
</Layouts.app>
