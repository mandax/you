<Layouts.app flash={@flash} current_scope={@current_scope} active_tab="settings">
  <:side_panel>
    <div class="text-[11px] font-medium text-muted-foreground uppercase tracking-widest">
      Settings
    </div>
    <a
      href="#general"
      class="text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      General
    </a>
    <a
      href="#password"
      class="text-sm text-muted-foreground hover:text-foreground transition-colors"
    >
      Password
    </a>
  </:side_panel>

  <div class="space-y-10">
    <section id="general">
      <h2 class="text-lg font-medium tracking-tight mb-6">Email</h2>
      <.form :let={f} for={@email_changeset} action={~p"/users/settings"} id="update_email">
        <input type="hidden" name="action" value="update_email" />
        <div class="space-y-4 max-w-sm">
          <.input
            field={f[:email]}
            type="email"
            label="Email"
            autocomplete="username"
            spellcheck="false"
            required
          />
          <.button type="submit" variant="default" phx-disable-with="Changing...">Change Email</.button>
        </div>
      </.form>
    </section>

    <div class="border-t border-border" />

    <section id="password">
      <h2 class="text-lg font-medium tracking-tight mb-6">Password</h2>
      <.form :let={f} for={@password_changeset} action={~p"/users/settings"} id="update_password">
        <input type="hidden" name="action" value="update_password" />
        <div class="space-y-4 max-w-sm">
          <.input
            field={f[:password]}
            type="password"
            label="New password"
            autocomplete="new-password"
            spellcheck="false"
            required
          />
          <.input
            field={f[:password_confirmation]}
            type="password"
            label="Confirm new password"
            autocomplete="new-password"
            spellcheck="false"
            required
          />
          <.button type="submit" variant="default" phx-disable-with="Changing...">Save Password</.button>
        </div>
      </.form>
    </section>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-medium">Active sessions</h2>
          <p class="text-sm text-muted-foreground">Devices currently signed in to your account.</p>
        </div>
        <.link
          :if={length(@sessions) > 1}
          href={~p"/users/settings/sessions"}
          method="delete"
          data-confirm="Sign out of all other sessions?"
          class="text-sm text-destructive hover:underline"
        >
          Sign out everywhere else
        </.link>
      </div>

      <ul class="divide-y divide-border rounded-lg border border-border">
        <li :for={s <- @sessions} class="flex items-center justify-between px-4 py-3">
          <div class="text-sm">
            <div class="flex items-center gap-2">
              <span class="lucide-monitor size-4 block text-muted-foreground" />
              <span>Session</span>
              <span
                :if={s.token == @current_token}
                class="rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary"
              >
                This device
              </span>
            </div>
            <div class="mt-1 font-mono text-xs text-muted-foreground">
              signed in {Calendar.strftime(s.authenticated_at || s.inserted_at, "%Y-%m-%d %H:%M UTC")}
            </div>
          </div>
          <.link
            :if={s.token != @current_token}
            href={~p"/users/settings/sessions/#{s.id}"}
            method="delete"
            data-confirm="Revoke this session?"
            class="text-sm text-muted-foreground hover:text-destructive"
          >
            Revoke
          </.link>
        </li>
      </ul>
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-lg font-medium">Connected accounts</h2>
        <p class="text-sm text-muted-foreground">
          External identity providers linked to your account.
        </p>
      </div>

      <p :if={@federated_identities == []} class="text-sm text-muted-foreground">
        No connected accounts.
      </p>

      <ul
        :if={@federated_identities != []}
        class="divide-y divide-border rounded-lg border border-border"
      >
        <li
          :for={identity <- @federated_identities}
          class="flex items-center justify-between px-4 py-3"
        >
          <div class="text-sm">
            <div class="flex items-center gap-2">
              <span class="lucide-link size-4 block text-muted-foreground" />
              <span class="font-medium">{String.capitalize(identity.provider)}</span>
            </div>
            <div class="mt-1 font-mono text-xs text-muted-foreground">{identity.email}</div>
          </div>
          <.link
            href={~p"/users/settings/federated/#{identity.id}"}
            method="delete"
            data-confirm="Unlink this account?"
            class="text-sm text-muted-foreground hover:text-destructive"
          >
            Unlink
          </.link>
        </li>
      </ul>
    </section>
  </div>
</Layouts.app>
