<Layouts.public flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm pt-24 pb-32">
    <div class="text-center mb-10">
      <div class="size-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center mx-auto mb-4">
        <span class="text-sm font-bold">Y</span>
      </div>
      <h1 class="text-xl font-medium tracking-tight">Create your account</h1>
      <p class="text-sm text-muted-foreground mt-1">
        Already registered?
        <.link
          navigate={
            if @callback_url,
              do: ~p"/users/log-in?callback_url=#{URI.encode(@callback_url)}",
              else: ~p"/users/log-in"
          }
          class="font-medium text-foreground hover:underline"
        >
          Log in
        </.link>
      </p>
    </div>

    <.form :let={f} for={@changeset} action={~p"/users/register"}>
      <div class="space-y-4">
        <.input
          field={f[:email]}
          type="email"
          label="Email"
          autocomplete="username"
          spellcheck="false"
          required
          phx-mounted={JS.focus()}
        />

        <.button phx-disable-with="Creating account..." class="w-full">
          Create an account
        </.button>
      </div>
    </.form>
  </div>
</Layouts.public>
