<Layouts.public flash={@flash} current_scope={@current_scope}>
  <!-- Hero section -->
  <section class="mx-auto max-w-6xl px-6 pt-24 pb-32 sm:pt-32 sm:pb-40">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-base-300 px-3 py-1 text-xs text-base-content/50 mb-8">
        <span class="size-1.5 rounded-full bg-success animate-pulse" />
        v{Application.spec(:you, :vsn) || "0.1.0"}
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight leading-none text-balance">
        One identity for <span class="text-base-content/40">all your apps.</span>
      </h1>
      <p class="mt-6 text-base sm:text-lg text-base-content/50 leading-relaxed max-w-xl">
        You is a simple, secure IAM solution. Authenticate users across every app you build
        with a single drop-in SDK. Open source, self-hostable, and built for developers.
      </p>
      <div class="flex items-center gap-4 mt-10">
        <.link
          navigate={~p"/users/register"}
          class="btn btn-primary"
        >
          Get Started
        </.link>
        <.link
          href="https://hexdocs.pm/you"
          class="btn btn-soft"
        >
          Read the Docs
        </.link>
      </div>
    </div>
  </section>
  
<!-- Features section -->
  <section class="border-t border-base-300">
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <h2 class="text-2xl font-medium tracking-tight mb-16 text-center">
        Everything you need for auth
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="rounded-xl border border-base-300 p-6 space-y-3">
          <div class="size-10 rounded-lg bg-base-300 flex items-center justify-center">
            <.icon name="shield-check" class="size-5 text-base-content/60" />
          </div>
          <h3 class="font-medium">Secure by default</h3>
          <p class="text-sm text-base-content/50 leading-relaxed">
            Password hashing, TOTP, email magic links, and session management out of the box.
          </p>
        </div>
        <div class="rounded-xl border border-base-300 p-6 space-y-3">
          <div class="size-10 rounded-lg bg-base-300 flex items-center justify-center">
            <.icon name="refresh" class="size-5 text-base-content/60" />
          </div>
          <h3 class="font-medium">API-first</h3>
          <p class="text-sm text-base-content/50 leading-relaxed">
            GraphQL and REST APIs for every operation. Integrate from any language or framework.
          </p>
        </div>
        <div class="rounded-xl border border-base-300 p-6 space-y-3">
          <div class="size-10 rounded-lg bg-base-300 flex items-center justify-center">
            <.icon name="box" class="size-5 text-base-content/60" />
          </div>
          <h3 class="font-medium">Multi-app</h3>
          <p class="text-sm text-base-content/50 leading-relaxed">
            One user base, many apps. Manage access across your entire ecosystem from a single dashboard.
          </p>
        </div>
      </div>
    </div>
  </section>
  
<!-- Admin preview section -->
  <section class="border-t border-base-300">
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <div class="max-w-xl">
        <h2 class="text-2xl font-medium tracking-tight mb-4">
          Built-in admin dashboard
        </h2>
        <p class="text-base text-base-content/50 leading-relaxed mb-6">
          Manage users, apps, and settings from a clean, fast interface. Audit logs keep you
          informed of every change.
        </p>
        <div class="flex gap-4">
          <.link
            navigate={~p"/console"}
            class="btn btn-soft"
          >
            View Dashboard →
          </.link>
        </div>
      </div>
      
<!-- Simple mock screenshot area -->
      <div class="mt-12 rounded-xl border border-base-300 bg-base-200/50 p-8 overflow-hidden">
        <div class="flex items-center gap-2 text-xs text-base-content/30 mb-6">
          <span class="size-2 rounded-full bg-error" />
          <span class="size-2 rounded-full bg-warning" />
          <span class="size-2 rounded-full bg-success" />
          <span class="ml-2">admin/dashboard</span>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <div class="h-20 rounded-lg border border-base-300 bg-base-100 p-4 flex flex-col justify-between">
            <span class="text-[10px] text-base-content/40 uppercase tracking-wider">Users</span>
            <span class="text-2xl font-semibold">—</span>
          </div>
          <div class="h-20 rounded-lg border border-base-300 bg-base-100 p-4 flex flex-col justify-between">
            <span class="text-[10px] text-base-content/40 uppercase tracking-wider">Apps</span>
            <span class="text-2xl font-semibold">—</span>
          </div>
          <div class="h-20 rounded-lg border border-base-300 bg-base-100 p-4 flex flex-col justify-between">
            <span class="text-[10px] text-base-content/40 uppercase tracking-wider">
              Sessions
            </span>
            <span class="text-2xl font-semibold">—</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layouts.public>
