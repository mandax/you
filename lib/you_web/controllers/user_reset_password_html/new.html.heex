<Layouts.public flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm pt-24 pb-32">
    <div class="text-center mb-10">
      <div class="size-10 rounded-xl bg-neutral text-neutral-content flex items-center justify-center mx-auto mb-4">
        <span class="text-sm font-bold">Y</span>
      </div>
      <h1 class="text-xl font-medium tracking-tight">Forgot your password?</h1>
      <p class="text-sm text-base-content/50 mt-2">
        Enter your email and we'll send you a link to reset it.
      </p>
    </div>

    <.form :let={f} for={%{}} as={:user} action={~p"/users/reset-password"}>
      <div class="space-y-4">
        <.input
          field={f[:email]}
          type="email"
          label="Email"
          required
          phx-mounted={JS.focus()}
        />
        <.button class="btn btn-primary w-full">
          Send reset instructions
        </.button>
      </div>
    </.form>

    <p class="text-center text-sm text-base-content/50 mt-6">
      <.link navigate={~p"/users/log-in"} class="font-medium text-base-content hover:underline">
        Back to log in
      </.link>
    </p>
  </div>
</Layouts.public>
