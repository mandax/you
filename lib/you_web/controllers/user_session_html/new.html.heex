<Layouts.public flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm pt-24 pb-32 space-y-8">
    <div class="text-center mb-10">
      <div class="size-10 rounded-xl bg-neutral text-neutral-content flex items-center justify-center mx-auto mb-4">
        <span class="text-sm font-bold">Y</span>
      </div>
      <h1 class="text-xl font-medium tracking-tight">
        <%= if @current_scope do %>
          Confirm your identity
        <% else %>
          Log in to You
        <% end %>
      </h1>
      <p :if={!@current_scope} class="text-sm text-base-content/50 mt-1">
        Don't have an account?
        <.link
          navigate={
            if @callback_url,
              do: ~p"/users/register?callback_url=#{URI.encode(@callback_url)}",
              else: ~p"/users/register"
          }
          class="font-medium text-base-content hover:underline"
        >
          Sign up
        </.link>
        <span class="mx-3 text-base-content/20">·</span>
        <.link
          navigate={
            if @callback_url,
              do: ~p"/users/reset-password?callback_url=#{URI.encode(@callback_url)}",
              else: ~p"/users/reset-password"
          }
          class="font-medium text-base-content hover:underline"
        >
          Forgot password?
        </.link>
      </p>
    </div>

    <div :if={local_mail_adapter?()} class="rounded-lg border border-base-300 p-4 text-sm">
      <div class="flex items-start gap-3">
        <.icon name="info-circle" class="size-5 shrink-0 mt-0.5 text-base-content/40" />
        <div>
          <p class="font-medium">Local mail adapter</p>
          <p class="text-base-content/50 mt-1">
            To see sent emails, visit <.link href="/dev/mailbox" class="underline">the mailbox page</.link>.
          </p>
        </div>
      </div>
    </div>

    <.form :let={f} for={@form} as={:user} id="login_form_magic" action={~p"/users/log-in"}>
      <div class="space-y-4">
        <.input
          readonly={!!@current_scope}
          field={f[:email]}
          type="email"
          label="Email"
          autocomplete="username"
          spellcheck="false"
          required
          phx-mounted={JS.focus()}
        />
        <.button class="btn btn-primary w-full">
          Log in with email <span aria-hidden="true">→</span>
        </.button>
      </div>
    </.form>

    <div class="flex items-center gap-3 text-xs text-base-content/30">
      <span class="flex-1 border-t border-base-300" />
      <span>or</span>
      <span class="flex-1 border-t border-base-300" />
    </div>

    <.form :let={f} for={@form} as={:user} id="login_form_password" action={~p"/users/log-in"}>
      <div class="space-y-4">
        <.input
          readonly={!!@current_scope}
          field={f[:email]}
          type="email"
          label="Email"
          autocomplete="username"
          spellcheck="false"
          required
        />
        <.input
          field={f[:password]}
          type="password"
          label="Password"
          autocomplete="current-password"
          spellcheck="false"
        />
        <.button class="btn btn-primary w-full" name={@form[:remember_me].name} value="true">
          Log in and stay logged in <span aria-hidden="true">→</span>
        </.button>
        <.button class="btn btn-soft w-full mt-2">
          Log in only this time
        </.button>
      </div>
    </.form>
  </div>
</Layouts.public>
