<Layouts.public flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm pt-24 pb-32 space-y-8">
    <div class="text-center mb-10">
      <%= if assigns[:app_name] do %>
        <div class="size-10 rounded-xl border border-border flex items-center justify-center mx-auto mb-4">
          <span class="lucide-lock size-5 text-muted-foreground block" />
        </div>
        <h1 class="text-xl font-medium tracking-tight">
          Sign in to continue to <span class="text-primary">{@app_name}</span>
        </h1>
        <p class="text-xs text-muted-foreground mt-1.5">secured by You</p>
      <% else %>
        <div class="size-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center mx-auto mb-4">
          <span class="text-sm font-bold">Y</span>
        </div>
        <h1 class="text-xl font-medium tracking-tight">
          <%= if @current_scope do %>
            Confirm your identity
          <% else %>
            Log in to You
          <% end %>
        </h1>
      <% end %>
      <p :if={!@current_scope} class="text-sm text-muted-foreground mt-1">
        Don't have an account?
        <.link
          navigate={
            if @callback_url,
              do: ~p"/users/register?callback_url=#{URI.encode(@callback_url)}",
              else: ~p"/users/register"
          }
          class="font-medium text-foreground hover:underline"
        >
          Sign up
        </.link>
        <span class="mx-3 text-muted-foreground">·</span>
        <.link
          navigate={
            if @callback_url,
              do: ~p"/users/reset-password?callback_url=#{URI.encode(@callback_url)}",
              else: ~p"/users/reset-password"
          }
          class="font-medium text-foreground hover:underline"
        >
          Forgot password?
        </.link>
      </p>
    </div>

    <div :if={local_mail_adapter?()} class="rounded-lg border border-border p-4 text-sm">
      <div class="flex items-start gap-3">
        <.icon name="info-circle" class="size-5 shrink-0 mt-0.5 text-muted-foreground" />
        <div>
          <p class="font-medium">Local mail adapter</p>
          <p class="text-muted-foreground mt-1">
            To see sent emails, visit <.link href="/dev/mailbox" class="underline">the mailbox page</.link>.
          </p>
        </div>
      </div>
    </div>

    <.form :let={f} for={@form} as={:user} id="login_form_magic" action={~p"/users/log-in"}>
      <div class="space-y-4">
        <.input
          readonly={!!@current_scope}
          field={f[:email]}
          type="email"
          label="Email"
          autocomplete="username"
          spellcheck="false"
          required
          phx-mounted={JS.focus()}
        />
        <.button type="submit" class="w-full">
          Log in with email <span aria-hidden="true">→</span>
        </.button>
      </div>
    </.form>

    <div class="flex items-center gap-3 text-xs text-muted-foreground">
      <span class="flex-1 border-t border-border" />
      <span>or</span>
      <span class="flex-1 border-t border-border" />
    </div>

    <.form :let={f} for={@form} as={:user} id="login_form_password" action={~p"/users/log-in"}>
      <div class="space-y-4">
        <.input
          readonly={!!@current_scope}
          field={f[:email]}
          type="email"
          label="Email"
          autocomplete="username"
          spellcheck="false"
          required
        />
        <.input
          field={f[:password]}
          type="password"
          label="Password"
          autocomplete="current-password"
          spellcheck="false"
        />
        <.button type="submit" class="w-full" name={@form[:remember_me].name} value="true">
          Log in and stay logged in <span aria-hidden="true">→</span>
        </.button>
        <.button type="submit" variant="outline" class="w-full mt-2">
          Log in only this time
        </.button>
      </div>
    </.form>

    <div :if={@providers != [] or !@current_scope} class="space-y-3">
      <div class="flex items-center gap-3 text-xs text-muted-foreground">
        <span class="flex-1 border-t border-border" />
        <span>or continue with</span>
        <span class="flex-1 border-t border-border" />
      </div>
      <.button
        :for={provider <- @providers}
        href={~p"/auth/#{provider}"}
        variant="outline"
        class="w-full"
      >
        Sign in with {String.capitalize(provider)}
      </.button>
      <button
        :if={!@current_scope}
        id="passkey-login"
        type="button"
        data-start-url={~p"/users/log-in/passkey/start"}
        data-finish-url={~p"/users/log-in/passkey/finish"}
        class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors"
      >
        <span class="lucide-fingerprint size-4" /> Sign in with a passkey
      </button>
    </div>
  </div>
</Layouts.public>
