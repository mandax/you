<Layouts.public flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm pt-24 pb-32 space-y-6">
    <div class="text-center">
      <div class="size-10 rounded-xl bg-neutral text-neutral-content flex items-center justify-center mx-auto mb-4">
        <span class="text-sm font-bold">Y</span>
      </div>
      <h1 class="text-xl font-medium tracking-tight">Authorize</h1>
      <p class="text-sm text-base-content/50 mt-2">
        You are signed in as <strong>{@user_email}</strong>.<br /> An application at
        <strong>{@app_name}</strong>
        would like to access:
      </p>
    </div>

    <ul class="space-y-2">
      <li
        :for={scope <- @scopes}
        class="flex items-center gap-3 text-sm rounded-lg border border-base-300 p-3"
      >
        <.icon name="lock-open" class="size-4 shrink-0 text-base-content/40" />
        {scope}
      </li>
    </ul>

    <.form
      :let={_f}
      for={%{}}
      as={:authorize}
      id="authorize_form"
      action={~p"/users/log-in/authorize"}
    >
      <.button class="btn btn-primary w-full">
        Authorize <span aria-hidden="true">→</span>
      </.button>
    </.form>

    <.link href="/" class="btn btn-soft w-full">Cancel</.link>
  </div>
</Layouts.public>
