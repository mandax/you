<Layouts.public flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm pt-24 pb-32 space-y-6">
    <div class="text-center">
      <.wordmark size="lg" class="justify-center mb-4" />
      <h1 class="text-xl font-medium tracking-tight">Two-Factor Authentication</h1>
      <p class="text-sm text-muted-foreground mt-2">
        Enter the code from your authenticator app.
      </p>
    </div>

    <div
      :if={assigns[:error]}
      class="rounded-lg border border-destructive/30 bg-destructive/5 p-3 text-sm text-foreground flex items-center gap-2"
    >
      <.icon name="danger-circle" class="size-4 shrink-0 text-destructive" />
      {@error}
    </div>

    <.form :let={f} for={@form} as={:totp} id="totp_form" action={~p"/users/log-in/totp"}>
      <div class="space-y-4">
        <.input
          field={f[:code]}
          type="text"
          label="Authentication Code"
          autocomplete="off"
          spellcheck="false"
          required
          phx-mounted={JS.focus()}
        />
        <.button type="submit" class="w-full">Verify <span aria-hidden="true">→</span></.button>
      </div>
    </.form>
  </div>
</Layouts.public>
