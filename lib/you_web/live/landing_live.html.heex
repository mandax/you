<div class="min-h-screen bg-background text-foreground">
  <.site_nav current_scope={@current_scope} />

  <%!-- ── hero: animated discrete graph canvas, content left ── --%>
  <section class="relative overflow-hidden border-b border-border">
    <canvas
      id="graph-canvas"
      phx-hook="GraphCanvas"
      class="absolute inset-0 h-full w-full"
      aria-hidden="true"
    >
    </canvas>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-background/50 via-transparent to-background">
    </div>

    <div class="relative mx-auto flex min-h-[82vh] max-w-6xl flex-col justify-center px-5 pb-28 pt-24">
      <div class="max-w-2xl animate-rise-in">
        <.eyebrow>Self-hosted identity, standard OIDC</.eyebrow>
        <h1 class="text-balance text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-[3.4rem]">
          One login for every service you run.
          <span class="gradient-text">Your users' credentials stay on your hardware.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">
          Passwords, 2FA, magic links, audit. A self-hosted IAM with standard OIDC for any app
          and Erlang distribution for the BEAM apps you trust. Your users, your data, your node.
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <.button size="lg" class="h-11" href="#pricing">
            Self-host You <span class="lucide-arrow-right size-4 block" />
          </.button>
          <.button size="lg" variant="outline" class="h-11" href="#security">
            Read the security model
          </.button>
        </div>
        <p class="mt-3 font-mono text-xs text-muted-foreground">
          free community image · your cluster, your data · no account to run it
        </p>
      </div>
    </div>
  </section>

  <%!-- ── terminal: floats over the hero boundary ── --%>
  <div class="relative z-10 mx-auto -mt-20 max-w-4xl px-5">
    <div class="animate-rise-in rounded-xl shadow-2xl shadow-primary/10 [animation-delay:80ms]">
      <.terminal_pane tab={@tab} />
    </div>
  </div>

  <div class="mt-10 border-y border-border bg-card/40">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-6 gap-y-1 px-5 py-3 text-center font-mono text-xs text-muted-foreground">
      <%= for {item, i} <- Enum.with_index(YouWeb.LandingContent.trust_strip()) do %>
        <span :if={i > 0} class="text-border">·</span>
        <span>{item}</span>
      <% end %>
    </div>
  </div>

  <%!-- ── works with ──────────────────────────────────────────── --%>
  <section class="border-b border-border py-8">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-3 gap-y-2 px-5 text-center">
      <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
        Works with
      </span>
      <span
        :for={label <- YouWeb.LandingContent.works_with()}
        class="font-mono text-sm text-muted-foreground/80"
      >
        {label}
      </span>
    </div>
  </section>

  <%!-- ── security / threat model ────────────────────────────────── --%>
  <section id="security" class="border-b border-border py-20">
    <div class="mx-auto max-w-6xl px-5">
      <.eyebrow>01 · Security</.eyebrow>
      <h2 class="max-w-2xl text-3xl font-bold tracking-tight">
        Identity is the perimeter. Treat it like one.
      </h2>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        Every app you connect trusts whatever sits behind the login button. These are the concrete
        things attackers try against identity systems — and what You stops before it happens.
      </p>

      <div class="mt-10 grid gap-4 lg:grid-cols-2">
        <div class="rounded-xl border border-border bg-card p-6">
          <div class="flex items-center gap-2 text-signal-down">
            <span class="lucide-x size-4 block" />
            <h3 class="text-sm font-semibold uppercase tracking-wide">
              What attackers try
            </h3>
          </div>
          <ul class="mt-4 space-y-3 text-sm text-muted-foreground">
            <li :for={trick <- YouWeb.LandingContent.tricks()} class="flex items-start gap-2.5">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-signal-down/70" />
              {trick}
            </li>
          </ul>
        </div>

        <div class="rounded-xl border border-border bg-card p-6">
          <div class="flex items-center gap-2 text-signal-ok">
            <span class="lucide-shield size-4 block" />
            <h3 class="text-sm font-semibold uppercase tracking-wide">What You does</h3>
          </div>
          <ul class="mt-4 space-y-4">
            <li :for={block <- YouWeb.LandingContent.blocks()} class="flex items-start gap-2.5">
              <span class="lucide-check mt-0.5 size-4 block shrink-0 text-signal-ok" />
              <div>
                <div class="text-sm font-medium text-foreground">{block.title}</div>
                <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">{block.body}</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── security pillars ───────────────────────────────────────── --%>
  <section class="border-b border-border bg-card/30 py-20">
    <div class="mx-auto max-w-6xl px-5">
      <.eyebrow>02 · Built in, not bolted on</.eyebrow>
      <h2 class="max-w-2xl text-3xl font-bold tracking-tight">
        Every defense on by default, not a paid add-on.
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div
          :for={item <- YouWeb.LandingContent.security_items()}
          class="rounded-xl border border-border bg-background p-5"
        >
          <span class="lucide-lock size-5 block text-azure-brand" />
          <h3 class="mt-3 text-sm font-semibold">{item.title}</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">{item.body}</p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── when hosted auth is right ───────────────────────────────── --%>
  <section class="border-b border-border py-20">
    <div class="mx-auto max-w-6xl px-5">
      <.eyebrow>03 · When not to use You</.eyebrow>
      <h2 class="max-w-2xl text-3xl font-bold tracking-tight">
        Sometimes hosted auth is the right call.
      </h2>
      <p class="mt-3 max-w-2xl text-muted-foreground">
        You exists for one reason: identity that lives inside your own BEAM cluster. If that's not
        your constraint, other tools are simpler — here's the honest routing.
      </p>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <div
          :for={alt <- YouWeb.LandingContent.alternatives()}
          class={[
            "rounded-xl border bg-card p-6",
            if(alt.ours, do: "border-primary shadow-lg shadow-primary/10", else: "border-border")
          ]}
        >
          <span class={[
            alt.icon,
            "size-5 block",
            if(alt.ours, do: "text-primary", else: "text-muted-foreground")
          ]} />
          <h3 class="mt-4 font-semibold">{alt.title}</h3>
          <p class="mt-2 text-sm text-muted-foreground">{alt.body}</p>
          <div class={[
            "mt-4 font-mono text-xs",
            if(alt.ours, do: "text-primary", else: "text-muted-foreground")
          ]}>
            {alt.pick}
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── scale ───────────────────────────────────────────────── --%>
  <section class="border-b border-border bg-card/30 py-16">
    <div class="mx-auto grid max-w-6xl gap-4 px-5 md:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-xl border border-border bg-background p-7">
        <span class="lucide-cloud-off size-5 block text-primary" />
        <h3 class="mt-4 text-xl font-bold tracking-tight">Built to be ignorable</h3>
        <p class="mt-2 text-sm text-muted-foreground">
          Once a token is issued, apps verify it locally against your JWKS —
          You can go down and nobody notices.
        </p>
      </div>
      <div class="rounded-xl border border-border bg-background p-7">
        <span class="lucide-network size-5 block text-primary" />
        <h3 class="mt-4 text-xl font-bold tracking-tight">
          Distribution-native — no HTTP hop for token exchange
        </h3>
        <p class="mt-2 text-sm text-muted-foreground">
          Your app calls You's <code class="text-azure-brand">exchange_code</code>
          straight over Erlang distribution once the user redirects back with an auth code — no
          extra network hop, no shared webhook secret to rotate. For trusted nodes you
          control — distribution is full trust by design. Everyone else uses standard OIDC.
        </p>
      </div>
      <div class="rounded-xl border border-border bg-background p-7">
        <span class="lucide-plug size-5 block text-primary" />
        <h3 class="mt-4 text-xl font-bold tracking-tight">Add a consumer app in one row</h3>
        <p class="mt-2 text-sm text-muted-foreground">
          Register a callback URL and scope in the console and the app can redirect users to You
          immediately — no client libraries to install, no SDK to keep in sync.
        </p>
        <code class="mt-5 block rounded-lg border border-border bg-card px-3 py-2 font-mono text-xs text-azure-brand">
          You.SDK.exchange_code(auth_code)
        </code>
      </div>
    </div>
  </section>

  <%!-- ── comparison ──────────────────────────────────────────── --%>
  <section id="comparison" class="border-b border-border bg-card/30 py-20">
    <div class="mx-auto max-w-4xl px-5">
      <.eyebrow>04 · Honest comparison</.eyebrow>
      <h2 class="text-3xl font-bold tracking-tight">You vs the field.</h2>
      <p class="mt-3 text-muted-foreground">
        Hosted providers and JVM-based IdPs are both solid choices. You is the free, self-hosted
        take for teams running on the BEAM who want identity inside their own cluster.
      </p>
      <div class="mt-8 overflow-x-auto rounded-xl border border-border">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-border bg-muted/40 text-left">
              <th class="px-4 py-3 font-medium">Capability</th>
              <th class="px-4 py-3 text-center font-mono font-medium text-primary">You</th>
              <th class="px-4 py-3 text-center font-medium text-muted-foreground">Auth0</th>
              <th class="px-4 py-3 text-center font-medium text-muted-foreground">Keycloak</th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={{row, i} <- Enum.with_index(YouWeb.LandingContent.comparison())}
              class={rem(i, 2) == 1 && "bg-muted/20"}
            >
              <td class="px-4 py-3">{row.feature}</td>
              <td class="px-4 py-3"><.comparison_cell value={row.you} /></td>
              <td class="px-4 py-3"><.comparison_cell value={row.auth0} /></td>
              <td class="px-4 py-3"><.comparison_cell value={row.keycloak} /></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <%!-- ── pricing ─────────────────────────────────────────────── --%>
  <section id="pricing" class="border-b border-border py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="text-center">
        <.eyebrow>05 · Self-host</.eyebrow>
        <h2 class="text-3xl font-bold tracking-tight">Free to run. Yours to keep.</h2>
        <p class="mt-3 text-muted-foreground">
          MIT-licensed and open source — clone the repo or pull the prebuilt Docker image.
        </p>
      </div>
      <div class="mx-auto mt-10 max-w-md">
        <div
          :for={tier <- YouWeb.LandingContent.tiers()}
          class={[
            "relative rounded-2xl border bg-card p-6",
            if(tier.popular,
              do: "border-primary shadow-lg shadow-primary/10",
              else: "border-border"
            )
          ]}
        >
          <span
            :if={tier.popular}
            class="absolute -top-2.5 left-6 rounded-full bg-primary px-2.5 py-0.5 text-[11px] font-semibold text-primary-foreground"
          >
            {tier.tag}
          </span>
          <h3 class="font-semibold">{tier.name}</h3>
          <div class="mt-2 font-mono text-3xl font-bold">{tier.price}</div>
          <p :if={!tier.popular} class="mt-1 text-xs text-muted-foreground">{tier.tag}</p>
          <ul class="mt-5 space-y-2 text-sm text-muted-foreground">
            <li :for={point <- tier.points} class="flex items-center gap-2">
              <span class="lucide-check size-4 block text-signal-ok" />{point}
            </li>
          </ul>
          <.button variant={if(tier.popular, do: "default", else: "outline")} class="mt-6 w-full">
            {tier.cta}
          </.button>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── faq ─────────────────────────────────────────────────── --%>
  <section id="faq" class="border-b border-border py-20">
    <div class="mx-auto max-w-3xl px-5">
      <.eyebrow>06 · FAQ</.eyebrow>
      <h2 class="text-3xl font-bold tracking-tight">Questions, answered.</h2>
      <div class="mt-8 divide-y divide-border rounded-xl border border-border">
        <div :for={{faq, i} <- Enum.with_index(YouWeb.LandingContent.faqs())}>
          <button
            type="button"
            phx-click="toggle_faq"
            phx-value-index={i}
            aria-expanded={to_string(@faq_open == i)}
            aria-controls={"faq-#{i}"}
            class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-sm font-medium"
          >
            {faq.q}
            <span class={[
              "lucide-chevron-down size-4 block shrink-0 text-muted-foreground transition-transform",
              @faq_open == i && "rotate-180"
            ]} />
          </button>
          <p :if={@faq_open == i} id={"faq-#{i}"} class="px-5 pb-5 text-sm text-muted-foreground">
            {faq.a}
          </p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── final CTA ───────────────────────────────────────────── --%>
  <section class="aurora border-b border-border py-20">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Own your users. <span class="gradient-text">Run your own identity.</span>
      </h2>
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <.button size="lg" href="#pricing">
          Self-host You <span class="lucide-arrow-right size-4 block" />
        </.button>
        <.button size="lg" variant="outline" href="#security">Read the security model</.button>
      </div>
    </div>
  </section>

  <.site_footer />
</div>
