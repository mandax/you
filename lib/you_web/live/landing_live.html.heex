<div class="min-h-screen bg-background text-foreground">
  <%!-- Server-authored JSON, so raw/1 is not escaping user input. Curly-brace
        interpolation is inert inside <script>, hence <%= %>. --%>
  <script type="application/ld+json">
    <%= Phoenix.HTML.raw(@structured_data) %>
  </script>

  <.site_nav current_scope={@current_scope} />

  <%!-- ── hero: animated discrete graph canvas, content left ── --%>
  <section class="relative overflow-hidden border-b border-border/30">
    <canvas
      id="graph-canvas"
      phx-hook="GraphCanvas"
      class="absolute inset-0 h-full w-full"
      aria-hidden="true"
    >
    </canvas>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-background/50 via-transparent to-background">
    </div>

    <div class="relative mx-auto flex min-h-[82vh] max-w-6xl flex-col justify-center px-5 pb-28 pt-24">
      <div class="max-w-2xl animate-rise-in">
        <.eyebrow>Self-hosted identity, standard OIDC</.eyebrow>
        <h1 class="text-balance text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-[3.4rem]">
          One login for every service you run.
          <span class="gradient-text">Your users credentials stay on your hardware.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">
          <span class="you-badge">You</span> is a self-hosted identity and access management
          service: login UI, 2FA, magic links, passkeys, per-app roles, a management console,
          and an audit trail. Free and open source under MIT. Apps integrate over standard
          OIDC, or directly over Erlang distribution when they are BEAM apps you trust.
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <.button size="lg" class="h-11" href="#get-started">
            Get started <span class="lucide-arrow-right size-4 block" />
          </.button>
          <.button size="lg" variant="outline" class="h-11" href="#console">
            See the console
          </.button>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── motivation ──────────────────────────────────────── --%>
  <section class="border-b border-border/30 py-20 text-center">
    <div class="mx-auto max-w-6xl px-5">
      <.eyebrow>{YouWeb.LandingContent.motivation().eyebrow}</.eyebrow>
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight">
        {YouWeb.LandingContent.motivation().heading}
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
        {YouWeb.LandingContent.motivation().body}
      </p>
    </div>
  </section>

  <%!-- ── console / operations ────────────────────────────────── --%>
  <section id="console" class="border-b border-border/30 py-20 text-center">
    <div class="mx-auto max-w-6xl px-5">
      <.eyebrow>The console</.eyebrow>
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight">
        Identity you can actually operate.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
        <span class="you-badge">You</span> ships with a management console out of the box.
        Register apps, manage users and roles, watch the audit trail live, and tune the
        instance. No YAML, no restarts.
      </p>

      <%!-- Screencast of the real console, framed as a small window. --%>
      <div class="mx-auto mt-10 max-w-3xl">
        <div class="overflow-hidden rounded-xl border border-border bg-card shadow-lg">
          <div class="flex h-8 items-center gap-2 border-b border-border/60 bg-muted/40 px-3">
            <span class="size-2.5 rounded-full bg-signal-down/70" />
            <span class="size-2.5 rounded-full bg-signal-warn/70" />
            <span class="size-2.5 rounded-full bg-signal-ok/70" />
            <span class="ml-2 font-mono text-[11px] text-muted-foreground">
              you · /console
            </span>
          </div>
          <%!-- No controls: it loops silently as a moving screenshot. Muted is
                what makes autoplay allowed at all. --%>
          <video
            src={~p"/videos/console-tour.mp4"}
            poster={~p"/images/console-tour-poster.jpg"}
            autoplay
            muted
            loop
            playsinline
            disablepictureinpicture
            preload="auto"
            aria-label="Screencast of the You console"
            class="pointer-events-none block aspect-[8/5] w-full bg-background"
          />
        </div>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div
          :for={feature <- YouWeb.LandingContent.console_features()}
          class="flex flex-col items-center rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40"
        >
          <span class={[feature.icon, "size-5 block text-azure-brand"]} />
          <h3 class="mt-3 text-sm font-semibold">{feature.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{feature.body}</p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── user dashboard / account area ─────────────────────── --%>
  <section id="dashboard" class="border-b border-border/30 py-20 text-center">
    <div class="mx-auto max-w-6xl px-5">
      <.eyebrow>The account area</.eyebrow>
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight">
        Every user gets an account page at /users/dashboard.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
        It lists the apps they granted access to, their active sessions, their passkeys,
        their two-factor settings and any external accounts they linked. It comes with the
        instance, so your app does not have to render any of it.
      </p>

      <%!-- Screencast of the real account area, framed as a small window. --%>
      <div class="mx-auto mt-10 max-w-3xl">
        <div class="overflow-hidden rounded-xl border border-border bg-card shadow-lg">
          <div class="flex h-8 items-center gap-2 border-b border-border/60 bg-muted/40 px-3">
            <span class="size-2.5 rounded-full bg-signal-down/70" />
            <span class="size-2.5 rounded-full bg-signal-warn/70" />
            <span class="size-2.5 rounded-full bg-signal-ok/70" />
            <span class="ml-2 font-mono text-[11px] text-muted-foreground">
              you · /users/dashboard
            </span>
          </div>
          <video
            src={~p"/videos/dashboard-tour.mp4"}
            poster={~p"/images/dashboard-tour-poster.jpg"}
            autoplay
            muted
            loop
            playsinline
            disablepictureinpicture
            preload="auto"
            aria-label="Screencast of the You account area"
            class="pointer-events-none block aspect-[8/5] w-full bg-background"
          />
        </div>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div
          :for={feature <- YouWeb.LandingContent.dashboard_features()}
          class="flex flex-col items-center rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40"
        >
          <span class={[feature.icon, "size-5 block text-magenta-brand"]} />
          <h3 class="mt-3 text-sm font-semibold">{feature.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{feature.body}</p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── features: everything but the console and the account area ── --%>
  <section id="features" class="border-b border-border/30 py-20 text-center">
    <div class="mx-auto max-w-6xl px-5">
      <.eyebrow>Everything else</.eyebrow>
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight">
        What ships besides those two screens.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
        Pink is what a person signing in gets. Blue is what your apps and scripts talk to.
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div
          :for={feature <- YouWeb.LandingContent.features()}
          class="flex flex-col items-center rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40"
        >
          <span class={[
            feature.icon,
            "size-5 block",
            feature.audience == :user && "text-magenta-brand",
            feature.audience == :dev && "text-azure-brand"
          ]} />
          <h3 class="mt-3 text-sm font-semibold">{feature.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{feature.body}</p>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── when hosted auth is right ───────────────────────────────── --%>
  <section class="border-b border-border/30 py-20 text-center">
    <div class="mx-auto max-w-6xl px-5">
      <.eyebrow>When not to use <span class="you-badge">You</span></.eyebrow>
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight">
        Sometimes hosted auth is the right call.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
        <span class="you-badge">You</span>
        keeps identity on hardware you control, and any app talks to it over standard OIDC.
        If you would rather not run identity yourself at all, a hosted provider is less work.
      </p>
      <div class="mx-auto mt-10 grid max-w-4xl gap-4 md:grid-cols-2">
        <div
          :for={alt <- YouWeb.LandingContent.alternatives()}
          class={[
            "flex flex-col items-center rounded-xl border bg-card p-6",
            if(alt.ours, do: "border-primary shadow-lg shadow-primary/10", else: "border-border")
          ]}
        >
          <span class={[
            alt.icon,
            "size-5 block",
            if(alt.ours, do: "text-primary", else: "text-muted-foreground")
          ]} />
          <h3 class="mt-4 font-semibold">{alt.title}</h3>
          <p class="mt-2 text-sm text-muted-foreground">{alt.body}</p>
          <div class={[
            "mt-4 font-mono text-sm",
            if(alt.ours, do: "text-primary", else: "text-muted-foreground")
          ]}>
            <%= if alt.ours do %>
              Use <span class="you-badge">You</span>
            <% else %>
              {alt.pick}
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── get started ─────────────────────────────────────────── --%>
  <section id="get-started" class="border-b border-border/30 py-20 text-center">
    <div class="mx-auto max-w-4xl px-5">
      <.eyebrow>07 · Get started</.eyebrow>
      <h2 class="text-3xl font-bold tracking-tight">Running in five minutes.</h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
        Free and open source under MIT. Build from source or pull the image, bootstrap
        the first admin, then point an app at it.
      </p>

      <div class="mt-10 space-y-4">
        <div
          :for={{step, i} <- Enum.with_index(YouWeb.LandingContent.setup_steps(), 1)}
          class="rounded-xl border border-border bg-card p-6 text-left"
        >
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-sm text-magenta-brand">0{i}</span>
            <h3 class="font-semibold">{step.title}</h3>
          </div>
          <p class="mt-1.5 text-sm text-muted-foreground">{Phoenix.HTML.raw(step.body)}</p>
          <pre
            :if={step.code}
            class="mt-4 overflow-x-auto rounded-lg border border-border bg-background px-4 py-3 text-left font-mono text-xs leading-relaxed text-foreground/90"
          >{step.code}</pre>
        </div>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <.link
          :for={doc <- YouWeb.LandingContent.doc_links()}
          href={doc.href}
          class="group flex items-center justify-between rounded-xl border border-border bg-card px-5 py-4 text-left transition-colors hover:border-primary/40"
        >
          <div>
            <div class="text-sm font-semibold group-hover:text-primary">{doc.title}</div>
            <p class="mt-0.5 text-sm text-muted-foreground">{doc.body}</p>
          </div>
          <span class="lucide-arrow-up-right size-4 block shrink-0 text-muted-foreground group-hover:text-primary" />
        </.link>
      </div>
    </div>
  </section>

  <.site_footer />
</div>
