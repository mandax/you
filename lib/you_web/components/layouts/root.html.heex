<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="You" suffix=" · You" phx-no-format>{assigns[:page_title]}</.live_title>
    <%!-- Both opt-in: a page that has nothing meaningful to say is better off
          letting the crawler synthesize a snippet, and a canonical pointing at
          the wrong URL is worse than none. --%>
    <meta :if={assigns[:page_description]} name="description" content={@page_description} />
    <link :if={assigns[:canonical_url]} rel="canonical" href={@canonical_url} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script
      :if={analytics = Application.get_env(:you, :analytics)}
      defer
      data-domain={analytics[:domain]}
      src={analytics[:src]}
    >
    </script>
    <script>
      // Applies the theme before first paint to avoid a flash of the wrong one.
      // Same storage key and "system" semantics as the theme toggle hook.
      (function() {
        var theme = localStorage.getItem('you-theme');
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    {@inner_content}
  </body>
</html>
