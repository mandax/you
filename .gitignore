# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
you-*.tar

# SQLite database files
priv/repo/*.db
priv/repo/*.db-shm
priv/repo/*.db-wal

# Elixir tools
/.elixir-tools/

# Bucket storage
/bucket/

# Audit log files (created at runtime)
priv/log/*.jsonl

# Backup artifacts
backup.log
dev.db
you_dev.db

# Environment files
.env
.env.*
# ...except the template docker-compose.yml tells people to copy. It holds
# placeholders only; every real secret is generated on first boot.
!.env.example

# Node.js dependencies (used by Tailwind CLI build pipeline)
/node_modules/

# Built asset bundles — produced by `mix assets.deploy` (now built in the Docker image)
/priv/static/assets/css/app.css
/priv/static/assets/js/app.js

# phx.digest outputs: hashed copies, gzips, and the manifest
/priv/static/cache_manifest.json
priv/static/**/*.gz
priv/static/**/*-????????????????????????????????.*

# Agent worktrees, created at runtime
.claude/worktrees/

# Secrets generated on first boot next to the database file
/priv/repo/secret_key_base
/priv/repo/jwt_signing_key
/priv/repo/single_app_client_secret
