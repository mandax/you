# Copy to .env and edit. Used by docker-compose.yml (single-app install).
# No secrets here: SECRET_KEY_BASE and JWT_SIGNING_KEY are generated on first
# boot and persisted to the you-data volume.

# Which published image to run. Unset tracks `latest`, so `docker compose pull`
# crosses every release at once; pin it to decide when you cross one, and read
# CHANGELOG.md before bumping.
# YOU_VERSION=0.4.0

# Public hostname users reach You on (no scheme). TLS is terminated by your
# reverse proxy; You builds https URLs from this.
PHX_HOST=id.example.com

# Scheme for generated URLs. Leave unset behind Cloudflare or any TLS proxy.
# Set to http only for localhost or a private network — it also drops the
# `secure` flag from the session cookie, which browsers will not send over
# plaintext. Any other value aborts the boot rather than guessing.
# PHX_SCHEME=http


# The one app this instance serves. These seed it on first boot only; after
# that the console owns them, so changes here have no further effect. All
# optional — unset, the callback points back at this instance until you set a
# real one in the console.
SINGLE_APP_SLUG=app
SINGLE_APP_NAME=My App
SINGLE_APP_CALLBACK_URL=https://app.example.com/auth/callback
SINGLE_APP_LAUNCH_URL=https://app.example.com

# Email. Without SMTP_HOST, mail is kept in an in-memory mailbox readable at
# /console/mailbox and the console reports the install as not production ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# Management REST API bearer token. Leave empty to keep the API disabled.
API_TOKEN=

# WebAuthn relying-party id passkeys are bound to. Unset derives it from
# PHX_HOST above, unchanged from before this existed. Pin it explicitly once
# you serve more than one hostname — a later PHX_HOST edit otherwise silently
# strands every passkey. Changing this value itself is just as destructive,
# in both directions: a maintenance-window operation, not a routine edit.
# WEBAUTHN_RP_ID=id.example.com

# The pattern app hostnames follow, one {label} placeholder. Unset means
# per-app hostnames are off. Only half the switch — the "Per-app hostnames"
# feature has to be turned on in the console too: this variable is the
# Operator's, that toggle is the Admin's. Point DNS (a wildcard for the
# suffix is simplest) and get a certificate covering it before setting this,
# and run `mix you.audit_hostname_labels` after any change here.
# APP_HOSTNAME_TEMPLATE={label}.example.com

# Number of reverse proxies between this container and the internet that are
# known to append to (not replace) X-Forwarded-For. This compose file always
# puts one in front of you (it binds to 127.0.0.1 and expects your own
# reverse proxy or tunnel client to terminate TLS), so uncomment this to key
# the login rate limits on each caller's real address instead of that one
# proxy's — every client behind it otherwise shares a single bucket. Verify
# the count for your actual chain (docs/ops/deploy.md) before setting it:
# a proxy in front of a proxy — Cloudflare's proxy in front of your own
# nginx or Caddy, say — is 2, not 1. Left unset (0), which is only correct
# if this container is somehow directly reachable from the internet.
# TRUSTED_PROXY_HOPS=1

# Temporary diagnostic, not a setting to leave on: any non-empty value logs
# the raw X-Forwarded-For entries and the resolved client IP for every
# rate-limited request, so you can confirm TRUSTED_PROXY_HOPS above against
# a real request through your real chain. Turn on, send one request, read
# `docker compose logs`, turn back off.
# TRUSTED_PROXY_HOPS_DEBUG=1
